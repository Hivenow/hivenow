{
  "expo": {
    "name": "Hive",
    "slug": "hivenow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hivenow",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.hivenow.customer",
      "supportsTablet": true
    },
    "android": {
      "package": "in.hivenow.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5C22B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5C22B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
